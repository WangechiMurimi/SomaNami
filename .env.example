# Copy to .env and fill in. Never commit .env.

# Which model answers /api/chat: ollama (the default when empty) or claude.
# Server-side only: the browser calls our /api/chat route, and only that
# route calls the model.
LLM_PROVIDER=

# Our self-hosted Ollama server: the default, and the only provider allowed in
# production. Its base URL, e.g. http://localhost:11434 for a local Ollama or
# the HTTPS address of the Caddy gateway in front of the Azure VM (#151).
OLLAMA_BASE_URL=
# The gateway's key, sent as "Authorization: Bearer <key>". Leave empty for a
# local Ollama with no gateway. A secret: never commit it.
OLLAMA_API_KEY=
# Optional; defaults to qwen2.5:3b.
OLLAMA_MODEL=
# Optional whole-answer deadline in ms, retry included; defaults to 7000 so
# auth and the materials load still fit inside Netlify's 10 s function limit.
# Raise it only for local development against a slow machine.
OLLAMA_TIMEOUT_MS=

# Waking the Ollama VM on request (#201). Optional: leave all four empty and a
# sleeping VM is simply unreachable. infra/azure/create-waker.sh prints them;
# the secret only once. Server-side only, never VITE_*.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# A secret: never commit it.
AZURE_CLIENT_SECRET=
# /subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Compute/virtualMachines/<name>
AZURE_VM_RESOURCE_ID=

# Claude, for local development only. Refused when CONTEXT=production (set by
# Netlify), so never configure it on the production site.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low | medium | high

# Port the Express API listens on. Defaults to 3001.
PORT=3001

# Supabase Auth (#114). Both are public by design and end up in the browser
# bundle; the service-role key is never needed and must never be added here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Its secret lives in the Supabase
# dashboard under Auth > Bot and Abuse Protection, not in this repo.
VITE_TURNSTILE_SITE_KEY=

# The server verifies session tokens against this project's public keys.
SUPABASE_URL=
# The chat route loads a learner's materials from Supabase as that learner,
# with their own token, so row-level security applies (#148). This is the same
# public publishable key as above; leave it empty to reuse
# VITE_SUPABASE_PUBLISHABLE_KEY. Never put a secret or service-role key here:
# the server refuses one.
SUPABASE_PUBLISHABLE_KEY=
