# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Server-side only: the browser calls our
# /api/chat route, and only that route calls Anthropic.
ANTHROPIC_API_KEY=

# Optional overrides for the chat route.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low | medium | high

# Port the Express API listens on. Defaults to 3001.
PORT=3001
