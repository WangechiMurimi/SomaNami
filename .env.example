# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Server-side only: the browser calls our
# /api/chat route, and only that route calls Anthropic.
ANTHROPIC_API_KEY=

# Optional overrides for the chat route.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low | medium | high

# Port the Express API listens on. Defaults to 3001.
PORT=3001

# Supabase Auth (#114). Both are public by design and end up in the browser
# bundle; the service-role key is never needed and must never be added here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Its secret lives in the Supabase
# dashboard under Auth > Bot and Abuse Protection, not in this repo.
VITE_TURNSTILE_SITE_KEY=

# The server verifies session tokens against this project's public keys.
SUPABASE_URL=
