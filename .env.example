# Copy to .env and fill in. Never commit .env.

# Which model answers /api/chat: ollama (default) or claude. Server-side
# only: the browser calls our /api/chat route, and only that route calls the
# model.
LLM_PROVIDER=ollama

# Our self-hosted Ollama server (the default, and the only provider allowed
# in production).
OLLAMA_BASE_URL=http://localhost:11434
# Bearer token, only if Ollama sits behind an auth proxy.
OLLAMA_API_KEY=
# OLLAMA_MODEL=qwen2.5:3b
# Whole-answer deadline in ms; keep it under Netlify's ~10 s function limit.
# OLLAMA_TIMEOUT_MS=8500

# Claude, for local development only. Refused when CONTEXT=production
# (set by Netlify), so never configure it on the production site.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low | medium | high

# Port the Express API listens on. Defaults to 3001.
PORT=3001

# Supabase Auth (#114). Both are public by design and end up in the browser
# bundle; the service-role key is never needed and must never be added here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Its secret lives in the Supabase
# dashboard under Auth > Bot and Abuse Protection, not in this repo.
VITE_TURNSTILE_SITE_KEY=

# The server verifies session tokens against this project's public keys.
SUPABASE_URL=
# The chat route loads a learner's materials from Supabase as that learner,
# with their own token, so row-level security applies (#148). This is the same
# public publishable key as above; leave it empty to reuse
# VITE_SUPABASE_PUBLISHABLE_KEY. Never put a secret or service-role key here:
# the server refuses one.
SUPABASE_PUBLISHABLE_KEY=
