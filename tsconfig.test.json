{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Tests run under Vitest in Node (jsdom), so they may use Node APIs such as
    // reading fixtures; app code stays browser-only.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
